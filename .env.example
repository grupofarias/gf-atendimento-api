# Aplicacao
PORT=3200
NODE_ENV=development

# Chave mestra para criptografia AES-256-GCM de credenciais no banco
# Gerar com: openssl rand -hex 32
APP_SECRET=change_me_generate_with_openssl_rand_hex_32

# Chave compartilhada entre n8n e middleware
MIDDLEWARE_API_KEY=change_me_generate_random_key

# PostgreSQL (Docker Swarm: nome do servico = postgres)
DATABASE_URL=postgresql://gf_atendimento:senha@postgres:5432/gf_atendimento

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO (resolucao de URL de midia)
MINIO_ENDPOINT=s3minio.infragf.com.br
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=chatwoot
