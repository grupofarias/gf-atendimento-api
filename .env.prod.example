# ==============================================================================
# NUNCA use os valores de .env.example em produção.
# NUNCA commite este arquivo com valores reais.
# ==============================================================================

# Aplicacao
PORT=3200
NODE_ENV=production

# Chave mestra para criptografia AES-256-GCM
# Gerar com: openssl rand -hex 32
APP_SECRET=SUBSTITUA_COM_openssl_rand_hex_32

# Chave compartilhada entre n8n e middleware
# Gerar com: openssl rand -hex 32
MIDDLEWARE_API_KEY=SUBSTITUA_COM_openssl_rand_hex_32

# PostgreSQL
# Formato: postgresql://usuario:senha@host:5432/banco
DATABASE_URL=postgresql://gf_atendimento:SENHA_FORTE@postgres:5432/gf_atendimento
POSTGRES_USER=gf_atendimento
POSTGRES_PASSWORD=SENHA_FORTE
POSTGRES_DB=gf_atendimento

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=s3minio.infragf.com.br
MINIO_PORT=443
MINIO_USE_SSL=true
# Gerar com: openssl rand -hex 16
MINIO_ACCESS_KEY=SUBSTITUA_ACCESS_KEY
MINIO_SECRET_KEY=SUBSTITUA_SECRET_KEY
MINIO_BUCKET=chatwoot

# Chatwoot (URL base para health check)
# Exemplo: https://chatwoot.seudominio.com.br
CHATWOOT_BASE_URL=https://chatwoot.seudominio.com.br
